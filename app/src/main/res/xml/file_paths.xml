<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path
        name="places"
        path="places/" />
    <cache-path
        name="qr_share"
        path="share/" />
    <!-- APK scaricato per l'aggiornamento: l'installatore di sistema riceve
         il file come content:// (nessun permesso sull'archiviazione), e la
         cartella resta visibile solo a questa app. -->
    <cache-path
        name="apk_update"
        path="apk/" />
    <!-- WAV delle sessioni audio, per la condivisione di debug: la cartella e'
         privata dell'app, l'altra app riceve solo il content:// che le passa
         il chooser. -->
    <files-path
        name="debug_audio"
        path="debug_audio/" />
</paths>
