<?xml version="1.0" encoding="utf-8"?>
<!--
  Livello monochrome dell'icona adattiva: serve ai launcher con le icone a
  tema (Android 13+), che lo ritingono con un colore solo ricavato dal
  sfondo. Senza di esso mostrerebbero l'icona a colori piena, o niente.
  Non e' la stessa cosa del foreground: quello e' ora la foto
  (drawable-nodpi/ic_launcher_image.png) e non puo' essere ritinta.
  Disegna bersaglio + punto centrale: cerchio esterno e cerchio interno con
  fillType evenOdd fanno l'anello, il terzo cerchio al centro resta pieno.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF9800"
        android:fillType="evenOdd"
        android:pathData="M54,54m-38,0a38,38 0,1 0,76 0a38,38 0,1 0,-76 0M54,54m-27,0a27,27 0,1 0,54 0a27,27 0,1 0,-54 0M54,54m-11,0a11,11 0,1 0,22 0a11,11 0,1 0,-22 0" />
</vector>
