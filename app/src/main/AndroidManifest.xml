<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- CPU sveglia durante la misura GPS (fase TRACKING): camminando con il
         telefono in mano lo schermo si spegne e Android mette la CPU in doze,
         perdendo i fix quando servono di piu'. Wake lock PARZIALE (non tiene
         acceso lo schermo), rilasciato a fine misura: vedi
         BackgroundPowerController. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Aggiornamento: lettura dell'ultima release su GitHub e scaricamento
         dell'APK. Senza questa l'app funziona identica, ma non si aggiorna. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Installazione dell'APK scaricato. L'app non installa nulla da sola:
         apre la schermata di conferma del sistema. Da Android 8 in poi serve
         anche che l'utente autorizzi Miraglio a installare app sconosciute. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- localeConfig: da Android 13 in poi espone Miraglio fra le app la cui
         lingua si puo' scegliere a parte (Impostazioni di sistema -> App ->
         Miraglio -> Lingua). Senza, l'app seguirebbe solo la lingua del
         telefono. Su Android 12 e precedenti l'attributo viene ignorato. -->
    <application
        android:name=".MiraglioApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Miraglio"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Condivisione delle foto dei luoghi (URI content:// senza permessi). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
