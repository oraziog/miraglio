# ---------------------------------------------------------------------------
# Output di build: mai versionati (l'APK debug pesa ~141 MB)
# ---------------------------------------------------------------------------
build/
app/build/
.gradle/
.kotlin/
*.apk
*.aab
*.apk.idsig

# ---------------------------------------------------------------------------
# Configurazione locale della macchina (percorso dell'SDK Android)
# ---------------------------------------------------------------------------
local.properties

# ---------------------------------------------------------------------------
# Contatore delle build di prova (D1, D2, ...): e' lo stato di questa macchina,
# non un file del progetto, e non deve arrivare a chi compila la release.
debug_version.txt

# Firma di rilascio: la chiave e la sua password non entrano nel repository
# ---------------------------------------------------------------------------
keystore.properties
*.jks
*.keystore

# ---------------------------------------------------------------------------
# Stato degli strumenti / agenti di sviluppo
# ---------------------------------------------------------------------------
.freebuff/

# ---------------------------------------------------------------------------
# Audio e video di lavoro nella radice del progetto: non fanno parte dell'app
# (i suoni del telemetro sono sintetici, vedi i test) e un MP3 da 20 MB in un
# commit non si toglie piu' dalla storia.
# ---------------------------------------------------------------------------
*.mp3
*.wav
# Eccezione: il WAV ritagliato da una registrazione reale è l'input di un test
# di regressione (vedi RealRecordingTest), non un file di lavoro da tenere fuori.
!app/src/test/resources/audio/*.wav
*.m4a

# ---------------------------------------------------------------------------
# Materiale di lavoro delle registrazioni (audio/video originali e script di
# analisi, ~1,5 GB): non fa parte dell'app e non entra nel repository.
# ---------------------------------------------------------------------------
analisi_tiri/

# ---------------------------------------------------------------------------
# Pagina locale delle build di prova (D1, D2, ...): l'APK e' gia' ignorato da
# *.apk, la pagina e la nota sono di questa macchina e non servono al progetto.
# ---------------------------------------------------------------------------
download_page/

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# ---------------------------------------------------------------------------
# Sistema operativo
# ---------------------------------------------------------------------------
Thumbs.db
.DS_Store

# ---------------------------------------------------------------------------
# Artefatti derivati, presenti nella cartella dei sorgenti
# ---------------------------------------------------------------------------
# Dump unico di tutti i .kt e backup dell'intero sorgente: non fanno parte del
# progetto (si rigenerano dal repository).
app/src/main/Codice_klotin_Unito.txt
app/src/main/*.7z
